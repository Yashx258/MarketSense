# Copy to .env and fill in. NEVER commit .env.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marketsense
DB_USER=marketsense
DB_PASSWORD=change_me
# Optional: full URL overrides the DB_* values above
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/marketsense

# Stock universe: "psxdata" (live KSE100 constituents) or "file" (config/stock_universe.csv)
STOCK_UNIVERSE_SOURCE=psxdata
STOCK_UNIVERSE_INDEX=KSE100
STOCK_UNIVERSE_FILE=config/stock_universe.csv

PRICE_START_DATE=2020-01-01
LOG_LEVEL=INFO

# News collection is OFF until you have read the source's terms (README -> "News & sentiment").
NEWS_COLLECTION_ENABLED=false
# Dawn's terms allow copying content only for personal, non-commercial use: article BODIES are not saved unless you opt in.
NEWS_STORE_ARTICLE_TEXT=false
# Identify yourself politely; add a contact address, e.g. "MarketSenseAcademicBot/0.1 (FYP at NU; you@example.com)"
NEWS_USER_AGENT=MarketSenseAcademicBot/0.1 (student research project)
NEWS_HTTP_TIMEOUT_SECONDS=20
# Post-close prediction cutoff (Asia/Karachi) used when selecting news for a prediction date (Model B)
NEWS_CUTOFF_TIME_PKT=17:00
SENTIMENT_MODEL=ProsusAI/finbert

# Placeholder (fundamentals not implemented)
YAHOO_SYMBOL_SUFFIX=.KA
